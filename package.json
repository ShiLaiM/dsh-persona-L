{
  "name": "@local/dsh-persona",
  "version": "0.8.0",
  "description": "Session-scoped persona cards that give the model a substantial, structured sense of its own personality",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShiLaiM/dsh-persona-L.git"
  },
  "homepage": "https://github.com/ShiLaiM/dsh-persona-L#readme",
  "bugs": {
    "url": "https://github.com/ShiLaiM/dsh-persona-L/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "roleplay"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
